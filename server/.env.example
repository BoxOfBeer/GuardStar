# Flask session signing key (change for production)
SECRET_KEY=dev-secret-key-change-me

# World/procedural seed + auth salt (change for production)
SERVER_SALT=dev-server-salt-change-me

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://guardstar:guardstar@127.0.0.1:5432/guardstar

# БД для интеграционных pytest (create_all при старте; тесты — только игроки gs_py_* + сброс сола). НЕ тот же URL, что рабочий DATABASE_URL.
# Создайте БД вручную: CREATE DATABASE guardstar_test;
TEST_DATABASE_URL=postgresql+psycopg://guardstar:guardstar@127.0.0.1:5432/guardstar_test

# Autotick (server-side game loop)
AUTO_TICK_ENABLED=false
AUTO_TICK_INTERVAL_SECONDS=5

# Admin web (/admin/world?token=…): при первом запуске, если в БД ещё пустой хэш, сохранится sha256(access_code + SERVER_SALT)
# ADMIN_TOKEN=my-secret-admin-string

# Схема БД: true = dev (create_all + аварийные ALTER в create_app). Для открытого плейтеста — false и только Alembic.
# GUARDSTAR_DB_SAFETY_NET=false
